TWITTER_BEARER_TOKEN=
OPENAI_API_KEY=
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=

# Product Hunt developer token — opcjonalny. Bez tokenu adapter degraduje się gracefully:
# zwraca pustą listę i loguje warn (pipeline NIE crashuje).
# Generacja: https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_DEVELOPER_TOKEN=

# Libraries.io API key — opcjonalny. Bez klucza adapter degraduje się gracefully:
# zwraca pustą listę i loguje warn.
# Rejestracja: https://libraries.io/api
LIBRARIES_IO_API_KEY=

# YouTube Data API v3 key — opcjonalny. Bez klucza adapter degraduje się gracefully.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Supabase (Postgres) — full JDBC URL z sslmode=require
# np. jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=
