TWITTER_BEARER_TOKEN=
OPENAI_API_KEY=
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=

# Product Hunt developer token — opcjonalny. Bez tokenu adapter degraduje się gracefully:
# zwraca pustą listę i loguje warn (pipeline NIE crashuje).
# Generacja: https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_DEVELOPER_TOKEN=

# YouTube Data API v3 key — opcjonalny. Bez klucza adapter degraduje się gracefully.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Feedback loop (C6) — opcjonalny. URL zewnętrznego receivera, do którego prowadzą linki 👍/👎
# w mailu (np. Supabase Edge Function piszący do tabeli `feedback`). Puste = brak linków.
FEEDBACK_RECEIVER_URL=

# SonarCloud scan token — opcjonalny. Włącza job `sonarcloud` w digest.yml; bez niego
# job jest pomijany (CI nie pada). Generacja: SonarCloud → My Account → Security.
# Można wypchnąć do repo przez scripts/gh-secrets-sync.sh.
SONAR_TOKEN=

# Supabase Session Pooler (NIE Direct connection — direct is IPv6-only on free tier)
# np. jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# --- GitHub CLI helper scripts (scripts/gh-secrets-*.sh) — NIE używane przez aplikację ---
# Opcjonalny token, którego te skrypty używają zamiast `gh auth login` z Twojego shella
# (omija problem zbyt wąskiego GH_TOKEN/GITHUB_TOKEN wyeksportowanego globalnie w .zshrc).
# Uprawnienia repo: "Secrets" (i "Variables") — Read dla check, Read+Write dla sync.
# Puste = skrypty użyją Twojego tokenu z `gh auth login`.
GH_TOKEN=
